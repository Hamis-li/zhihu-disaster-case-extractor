# Streamlit Secrets 配置示例
# 复制本文件为 .streamlit/secrets.toml 并填入真实密钥（secrets.toml 已被 .gitignore 排除，不会提交）
# 或直接在 Streamlit Cloud 的应用 Settings → Secrets 界面配置。
# TOML 格式：每行一个 键 = "值"，等号后不能换行。

# 必填：知乎开放平台 Access Secret（搜索 API + 直答 Agent API）
# 获取地址：https://developer.zhihu.com/profile
ZHIHU_ACCESS_SECRET = "在此粘贴你的知乎开放平台 Access Secret"

# OAuth 知乎登录需要：向 openplatform@zhihu.com 申请，或由黑客松赛事平台分配
# ZHIHU_OAUTH_APP_ID = "你的 OAuth App ID"
# ZHIHU_OAUTH_APP_KEY = "你的 OAuth App Key"

# 可选：回调地址覆盖（默认取当前部署域名根路径，须与申请时登记的 redirect_uri 逐字符一致）
# ZHIHU_OAUTH_REDIRECT_URI = "https://你的应用域名.streamlit.app"
